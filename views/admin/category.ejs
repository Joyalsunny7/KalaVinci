<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin - Category Management</title>

  <style>
    :root {
      --bg: #f8f8f8;
      --header: #82cea4;
      --table: #a5a5a5;
      --green: #4cd964;
      --red: #ff3b30;
      --pink: #e8848a;
      --input: #d9d9d9;
      --shadow: 0 4px 10px rgba(0, 0, 0, .05);
    }

    body {
      font-family: "Segoe UI", sans-serif;
      background: var(--bg);
      margin: 0;
      color: #333;
    }

    /* HEADER */
    .admin-header {
      background: #fff;
      padding: 15px 50px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 5px solid var(--header);
      box-shadow: var(--shadow);
    }

    .container {
      max-width: 1000px;
      margin: 40px auto;
      padding: 0 20px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    thead th {
      background: var(--table);
      color: #fff;
      padding: 14px;
      text-align: center;
    }

    tbody td {
      padding: 14px;
      text-align: center;
      border-bottom: 1px solid #eee;
    }

    /* Switch */
    .switch {
      width: 44px;
      height: 22px;
      position: relative;
      display: inline-block;
    }

    .switch input {
      display: none;
    }

    .slider {
      position: absolute;
      inset: 0;
      background: var(--red);
      border-radius: 20px;
      transition: .3s;
    }

    .slider::before {
      content: "";
      position: absolute;
      width: 16px;
      height: 16px;
      left: 3px;
      bottom: 3px;
      background: #fff;
      border-radius: 50%;
      transition: .3s;
    }

    input:checked+.slider {
      background: var(--green);
    }

    input:checked+.slider::before {
      transform: translateX(22px);
    }

    .btn-icon {
      background: #fff;
      border: 1px solid #ddd;
      padding: 6px 10px;
      border-radius: 6px;
      cursor: pointer;
    }

    .btn-delete {
      color: var(--red);
    }

    .add-card {
      background: #fff;
      border-radius: 30px;
      padding: 40px;
      box-shadow: var(--shadow);
      margin-top: 40px;
    }

    .input-group {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-top: 20px;
    }

    .input-group input {
      background: var(--input);
      border: none;
      padding: 12px 20px;
      border-radius: 6px;
      width: 300px;
      outline: none;
    }

    .save-btn {
      background: var(--pink);
      color: #fff;
      border: none;
      padding: 12px 60px;
      border-radius: 12px;
      font-weight: 700;
      cursor: pointer;
    }
  </style>
</head>

<body>

  <%- include('../partials/toast') %>
    <%- include('../partials/admin/sidebar') %>

      <!-- ✅ EVERYTHING GOES INSIDE main-content -->
      <main class="main-content">

        <div class="admin-header">
          <div><strong>Admin</strong> &gt; Category</div>

          <%- include('../partials/searchBar', { query: req.query, placeholder: 'Search categories...' ,
            clearUrl: '/admin/categories' }) %>

            <%- include('../partials/sortFilter', { query: req.query }) %>
        </div>

        <div class="container">

          <!-- TABLE -->
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Category</th>
                <th>Listed</th>
                <th>Action</th>
              </tr>
            </thead>

            <tbody>
              <% if (categories.length) { %>
                <% categories.forEach((cat, i)=> { %>
                  <tr data-id="<%= cat._id %>">
                    <td>
                      <%= i + 1 %>
                    </td>
                    <td class="col-name">
                      <%= cat.name %>
                    </td>
                    <td>
                      <label class="switch">
                        <input type="checkbox" <%=cat.isListed ? 'checked' : '' %>
                        onchange="toggleCategory('<%= cat._id %>')" />
                          <span class="slider"></span>
                      </label>
                    </td>
                    <td>
                      <button class="btn-icon" onclick="openEdit('<%= cat._id %>')">📝 Edit</button>
                      <button class="btn-icon btn-delete" onclick="deleteCategory('<%= cat._id %>')">🗑 Delete</button>
                    </td>
                  </tr>
                  <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="4">No categories found</td>
                      </tr>
                      <% } %>
            </tbody>
          </table>

          <%- include('../partials/pagination', { currentPage, totalPages, query: req.query }) %>

            <!-- ADD CATEGORY -->
            <div class="add-card">
              <h2>Add New Category</h2>

              <form method="POST" action="/admin/add-category">
                <div class="input-group">
                  <label>Name</label>
                  <input type="text" name="categoryName" required />
                </div>

                <div class="input-group">
                  <label class="switch">
                    <input type="checkbox" name="isListed" checked />
                    <span class="slider"></span>
                  </label>
                  <span>List category</span>
                </div>

                <div style="margin-top:30px;text-align:center">
                  <button class="save-btn">SAVE</button>
                </div>
              </form>
            </div>

        </div>
      </main>

</body>

</html>