<link rel="stylesheet" href="/css/partials/admin/sidebar.css">
<link rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  rel="stylesheet">

<aside class="sidebar">

  <!-- ================= HEADER ================= -->
  <div class="sidebar-header">
    <button class="hamburger" id="sidebarToggle" aria-label="Toggle sidebar">
      <i class="fa-solid fa-bars"></i>
    </button>

    <div class="profile">
      <img src="/images/ICON.png" alt="Admin">
      <div class="profile-text">
        <strong>Admin</strong>
        <span>KALA VINCI</span>
      </div>
    </div>
  </div>

  <!-- ================= NAV ================= -->
  <nav class="sidebar-nav">
    <ul>

      <li class="<%= activePage === 'dashboard' ? 'active' : '' %>">
        <a href="/admin/dashboard">
          <i class="fa-solid fa-gauge"></i>
          <span>Dashboard</span>
        </a>
      </li>

      <li class="<%= activePage === 'products' ? 'active' : '' %>">
        <a href="/admin/products">
          <i class="fa-solid fa-box"></i>
          <span>Products</span>
        </a>
      </li>

      <li class="<%= activePage === 'orders' ? 'active' : '' %>">
        <a href="/admin/orders">
          <i class="fa-solid fa-cart-shopping"></i>
          <span>Orders</span>
        </a>
      </li>

      <li class="<%= activePage === 'users' ? 'active' : '' %>">
        <a href="/admin/customers">
          <i class="fa-solid fa-users"></i>
          <span>Users</span>
        </a>
      </li>

      <li class="<%= activePage === 'reports' ? 'active' : '' %>">
        <a href="/admin/reports">
          <i class="fa-solid fa-chart-line"></i>
          <span>Reports</span>
        </a>
      </li>

      <li class="<%= activePage === 'coupons' ? 'active' : '' %>">
        <a href="/admin/coupons">
          <i class="fa-solid fa-ticket"></i>
          <span>Coupons</span>
        </a>
      </li>

      <!-- ======= CATALOG (WITH SPACING) ======= -->
      <li class="has-submenu <%= ['categories','styles','artists'].includes(activePage) ? 'active' : '' %>">
        <a href="#">
          <i class="fa-solid fa-layer-group"></i>
          <span>Catalog</span>
        </a>

        <ul class="submenu">
          <li class="<%= activePage === 'categories' ? 'active' : '' %>">
            <a href="/admin/categories">Category Management</a>
          </li>

          <li class="<%= activePage === 'styles' ? 'active' : '' %>">
            <a href="/admin/styles">Style Management</a>
          </li>

          <li class="<%= activePage === 'artists' ? 'active' : '' %>">
            <a href="/admin/artists">Artist Management</a>
          </li>
        </ul>
      </li>

      <li class="<%= activePage === 'banners' ? 'active' : '' %>">
        <a href="/admin/banners">
          <i class="fa-solid fa-image"></i>
          <span>Banners</span>
        </a>
      </li>

      <li class="<%= activePage === 'offers' ? 'active' : '' %>">
        <a href="/admin/offers">
          <i class="fa-solid fa-tag"></i>
          <span>Offers</span>
        </a>
      </li>

      <li class="<%= activePage === 'shipments' ? 'active' : '' %>">
        <a href="/admin/shipments">
          <i class="fa-solid fa-truck"></i>
          <span>Shipments</span>
        </a>
      </li>

      <li class="logout">
        <a href="/admin/logout">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Logout</span>
        </a>
      </li>

    </ul>
  </nav>
</aside>

<!-- ================= SCRIPT ================= -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sidebar = document.querySelector(".sidebar");
    const toggle = document.getElementById("sidebarToggle");
    const submenuLinks = document.querySelectorAll(".has-submenu > a");

    toggle.addEventListener("click", () => {
      sidebar.classList.toggle("collapsed");
      document.body.classList.toggle("sidebar-collapsed");
    });

    submenuLinks.forEach(link => {
      link.addEventListener("click", e => {
        if (sidebar.classList.contains("collapsed")) return;
        e.preventDefault();

        const parent = link.closest(".has-submenu");
        const isOpen = parent.classList.contains("active");

        document.querySelectorAll(".has-submenu")
          .forEach(item => item.classList.remove("active"));

        if (!isOpen) parent.classList.add("active");
      });
    });
  });
</script>
